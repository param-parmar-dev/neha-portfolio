# ---------------------------------------------------------------------------
# Apache / cPanel URL Rewriting for Clean URLs (No .html in browser)
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect /page.html to /page (301 Permanent Redirect)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
  RewriteRule ^ %1 [R=301,L]

  # Internally serve the .html file when /page is requested
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Fallback if mod_rewrite is not enabled
<IfModule !mod_rewrite.c>
  Options +MultiViews
</IfModule>
